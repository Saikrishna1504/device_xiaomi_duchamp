<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <androidx.cardview.widget.CardView
            android:id="@+id/card_current_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <RelativeLayout
                android:id="@+id/card_current_mode_bg"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/card_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_current_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:text="Balanced" />

                    <TextView
                        android:id="@+id/tv_current_mode_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#CCFFFFFF"
                        android:text="@string/thermalprofile_current_mode" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_current_mode_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_thermal_default"
                    android:alpha="0.85" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Balanced -->
                <LinearLayout
                    android:id="@+id/row_default"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/icon_default"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_thermal_default" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="@string/thermalprofile_default" />

                    <ImageView
                        android:id="@+id/radio_default"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/radiobutton_off_background" />

                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:layout_marginStart="56dp" android:background="?android:attr/listDivider"/>

                <!-- Performance -->
                <LinearLayout
                    android:id="@+id/row_performance"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/icon_performance"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_thermal_performance" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="@string/thermalprofile_performance" />

                    <ImageView
                        android:id="@+id/radio_performance"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/radiobutton_off_background" />

                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:layout_marginStart="56dp" android:background="?android:attr/listDivider"/>

                <!-- Battery Saver -->
                <LinearLayout
                    android:id="@+id/row_battery"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/icon_battery"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_thermal_battery" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="@string/thermalprofile_battery" />

                    <ImageView
                        android:id="@+id/radio_battery"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/radiobutton_off_background" />

                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:layout_marginStart="56dp" android:background="?android:attr/listDivider"/>

                <!-- Game -->
                <LinearLayout
                    android:id="@+id/row_game"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/icon_game"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_thermal_gaming" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="@string/thermalprofile_game" />

                    <ImageView
                        android:id="@+id/radio_game"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/radiobutton_off_background" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:text="@string/thermalprofile_auto_mode_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/thermalprofile_auto_mode_summary" />

                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_auto_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/thermalprofile_auto_mode_note" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
